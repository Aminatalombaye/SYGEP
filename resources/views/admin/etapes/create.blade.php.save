<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
$(document).ready(function() {
    function updatePonderation() {
        let pondFondation = getPonderation($('#fondation').val(), 20);
        let pondElevation = $('#elevation').length > 0 ? getPonderation($('#elevation').val(), 20) : 0;
        let pondPlancher = $('#plancher').length > 0 ? getPonderation($('#plancher').val(), 10) : 0;
        let pondEnduit = $('#enduit').length > 0 ? getPonderation($('#enduit').val(), 10) : 0;

        // Affiche même si les éléments ne sont pas présents (grâce à updateColorAndDisplay)
        updateColorAndDisplay('#fondation-ponderation', pondFondation);
        updateColorAndDisplay('#elevation-ponderation', pondElevation);
        updateColorAndDisplay('#plancher-ponderation', pondPlancher);
        updateColorAndDisplay('#enduit-ponderation', pondEnduit);

        let total = pondFondation + pondElevation + pondPlancher + pondEnduit;
        $('#total-ponderation').text(total + '%');
    }

    function getPonderation(status, poids) {
        if (status === "Réalisé") {
            return poids;
        } else if (
            status === "Non réalisé" || 
            status === "En préparation" || 
            status === "En cours de mise en œuvre"
        ) {
            return 0;
        }
        return 0;
    }

    function updateColorAndDisplay(id, pond) {
        let el = $(id);
        if (el.length > 0) {
            el.show()
              .text(' : ' + pond + '%')
              .css('color', pond > 0 ? 'green' : 'red');
        }
    }

    // Lancer la mise à jour initiale
    updatePonderation();

    // Attacher les événements si les éléments existent
    ['#fondation', '#elevation', '#plancher', '#enduit'].forEach(selector => {
        if ($(selector).length > 0) {
            $(selector).on('change', function() {
                updatePonderation();
            });
        }
    });
});
</script>

<script>
$(document).ready(function() {

    // Fonction principale
    function updateSecondOeuvrePonderation() {
        // Récupération des statuts
        let carrelage = $('#carrelage').val();
        let electricite = $('#electricite').val();
        let plomberie = $('#plomberie').val();
        let peinture = $('#peinture').val();
        let amenagement = $('#amenagement').val();

        // Calcul des pondérations individuelles
        let pondCarrelage   = (carrelage === 'Réalisé') ? 10 : 0;
        let pondElectricite = (electricite === 'Réalisé') ? 10 : (electricite === 'En préparation' ? 5 : 0);
        let pondPlomberie   = (plomberie === 'Réalisé') ? 10 : 0;
        let pondPeinture    = (peinture === 'Réalisé') ? 5  : 0;
        let pondAmenagement = (amenagement === 'Réalisé') ? 5  : 0;

        // Mise à jour affichage individuel avec condition de visibilité
        updateColorAndDisplay('#carrelage-ponderation', pondCarrelage, carrelage);
        updateColorAndDisplay('#electricite-ponderation', pondElectricite, electricite);
        updateColorAndDisplay('#plomberie-ponderation', pondPlomberie, plomberie);
        updateColorAndDisplay('#peinture-ponderation', pondPeinture, peinture);
        updateColorAndDisplay('#amenagement-ponderation', pondAmenagement, amenagement);

        // Total
        let totalSecondOeuvre = 0;
        [pondCarrelage, pondElectricite, pondPlomberie, pondPeinture, pondAmenagement].forEach(val => {
            totalSecondOeuvre += val;
        });

        // Affichage du total
        if (totalSecondOeuvre > 0) {
            $('#total-second-oeuvre').text(totalSecondOeuvre + '%').css('color', 'green');
        } else {
            $('#total-second-oeuvre').text('0%').css('color', 'red');
        }
    }

    // Fonction d'affichage conditionnel
    function updateColorAndDisplay(id, pond, status) {
        if (!status) {
            $(id).hide(); // Ne rien afficher si aucune option sélectionnée
            return;
        }

        if (pond > 0) {
            $(id).show().text(' : ' + pond + '%').css('color', 'green');
        } else {
            $(id).show().text(' : ' + pond + '%').css('color', 'red');
        }
    }

    // Écoute les changements
    $('#carrelage, #electricite, #plomberie, #peinture, #amenagement').change(function() {
        updateSecondOeuvrePonderation();
    });

    // Initialisation au chargement
    updateSecondOeuvrePonderation();
});
</script>





